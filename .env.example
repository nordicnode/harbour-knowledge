# Local development defaults. Copy to .env before running.
# The database runs in Docker on port 55432 so it never collides with a
# Postgres already installed on the machine.

# Docker Postgres bootstrap. These are read by docker compose; keep the
# MIGRATION_DATABASE_URL below in sync if you change the password or port.
POSTGRES_USER=kb
POSTGRES_PASSWORD=kb_dev_password
POSTGRES_DB=kb
POSTGRES_PORT=55432

# Used by the FastAPI service (RLS-enforced application role)
DATABASE_URL=postgresql://kb_app:kb_app_password@127.0.0.1:55432/kb
# Used only by migrations and the seed script
MIGRATION_DATABASE_URL=postgresql://kb:kb_dev_password@127.0.0.1:55432/kb

APP_ENV=development
API_PORT=8000
WEB_URL=http://127.0.0.1:3000
DEFAULT_TENANT_SLUG=harbour

# Read by the Next.js server. The defaults match the seeded workspace.
API_URL=http://127.0.0.1:8000
DEV_TENANT_SLUG=harbour
DEV_USER_EMAIL=maya@harbour.example

# --- AI providers -----------------------------------------------------------
# Chat and embeddings are selected independently.
#
# AI_MODE=dev    deterministic offline chat, no API key
# AI_MODE=openai any OpenAI-compatible Chat Completions endpoint
#
# EMBEDDING_PROVIDER=dev    deterministic hashed embeddings
# EMBEDDING_PROVIDER=local  Sentence-Transformers on this machine (recommended)
# EMBEDDING_PROVIDER=openai the endpoint's /embeddings route (requires AI_MODE=openai)
AI_MODE=dev
EMBEDDING_PROVIDER=dev

# Fully local chat with Ollama (see README):
# AI_MODE=openai
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# MODEL_INGEST_SMALL=qwen3:4b-instruct-2507-q4_K_M
# MODEL_REWRITE=qwen3:4b-instruct-2507-q4_K_M
# MODEL_ANSWER=qwen3:4b-instruct-2507-q4_K_M
# MODEL_JUDGE=qwen3:4b-instruct-2507-q4_K_M
# EMBEDDING_PROVIDER=local
# On a 6 GB GPU, leave the GPU to chat and embed on the CPU:
# LOCAL_EMBEDDING_DEVICE=cpu
# LOCAL_EMBEDDING_DTYPE=float32

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Optional: send embeddings to a different endpoint while chat stays on
# OPENAI_BASE_URL. Empty uses OPENAI_BASE_URL for both.
OPENAI_EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_API_KEY=

# Models are selected by role, never named in application code.
MODEL_INGEST_SMALL=
MODEL_REWRITE=
MODEL_ANSWER=
# Optional: stronger model for compound questions with several parts. Empty
# reuses MODEL_ANSWER.
MODEL_ANSWER_COMPLEX=
MODEL_JUDGE=
# Only required when EMBEDDING_PROVIDER=openai.
MODEL_EMBED=
# OpenAI-compatible embedding endpoints accept a `dimensions` parameter. Set
# this to false only for a provider that rejects the parameter; the model must
# still return exactly EMBEDDING_DIM values.
OPENAI_EMBEDDING_DIMENSIONS=true
# NVIDIA NIM asymmetric embedding models require input_type=query for questions
# and input_type=passage for indexed text. Leave false for OpenAI and other
# providers that reject the field.
OPENAI_EMBEDDING_INPUT_TYPE=false
# NVIDIA Nemotron reasoning models spend output tokens on a reasoning trace by
# default, which can leave no visible answer. Set true for NIM chat models that
# support chat_template_kwargs.enable_thinking.
OPENAI_DISABLE_THINKING=false
MODEL_RERANK=

# Optional rerank endpoint.
# Cohere-style providers: RERANK_API_STYLE=cohere, path defaults to /rerank.
# NVIDIA NIM: RERANK_API_STYLE=nim, path defaults to /ranking.
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_API_STYLE=cohere
# Override only when the endpoint has a different path, such as /reranking.
RERANK_PATH=
RERANK_TIMEOUT_SECONDS=60

# --- NVIDIA NIM via 9router (optional) --------------------------------------
# 9router exposes NVIDIA embeddings through an OpenAI-compatible endpoint.
# Copy the exact routed model ID from the 9router request example; in the
# tested 0.5.123 setup it is double-prefixed, e.g.
# nvidia/nvidia/nemotron-3.5-embed-8b.
# To keep local chat on Ollama and send only embeddings through 9router, set
# OPENAI_EMBEDDING_BASE_URL instead of replacing OPENAI_BASE_URL.
# To use NVIDIA chat directly (9router currently routes its chat model to 404):
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_API_KEY=<your NVIDIA API key>
# MODEL_ANSWER=nvidia/nemotron-3.5-lightning-30b-a3b
# Use the stronger Ultra model to resolve references in follow-up questions,
# answer compound requests, and run canonical question-equivalence checks.
# MODEL_REWRITE=nvidia/nemotron-3-ultra-550b-a55b
# MODEL_ANSWER_COMPLEX=nvidia/nemotron-3-ultra-550b-a55b
# MODEL_INGEST_SMALL=nvidia/nemotron-3.5-lightning-30b-a3b
# MODEL_JUDGE=nvidia/nemotron-3.5-lightning-30b-a3b
# OPENAI_DISABLE_THINKING=true
#
# To keep local chat on Ollama and send only embeddings through 9router, use
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1 and OPENAI_API_KEY=ollama instead:
# OPENAI_EMBEDDING_BASE_URL=http://127.0.0.1:20128/v1
# OPENAI_EMBEDDING_API_KEY=<your 9router API key>
# EMBEDDING_PROVIDER=openai
# MODEL_EMBED=nvidia/nvidia/nemotron-3.5-embed-8b
# OPENAI_EMBEDDING_INPUT_TYPE=true
# OPENAI_EMBEDDING_DIMENSIONS=true
#
# 9router currently has no rerank route. Call NVIDIA's hosted reranker
# directly; use /ranking for a local NIM container instead of /reranking.
# MODEL_RERANK=nvidia/nemotron-3.5-rerank-8b
# RERANK_API_STYLE=nim
# RERANK_BASE_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/nemotron-3.5-rerank-8b
# RERANK_PATH=/reranking
# RERANK_API_KEY=<your NVIDIA API key>
#
# Changing EMBEDDING_PROVIDER, MODEL_EMBED, or input_type changes the index
# identity. Run `make reindex` afterwards.

# The index uses 1024 dimensions (db/migrations/006_local_embeddings.sql).
# Provider, model, dimensions, query instruction, sequence limit, remote
# input_type, and EMBEDDING_VERSION are part of the index identity. Changing
# any of them requires `make reindex`; until then dense retrieval is disabled
# and Search and Ask report keyword-only mode.
EMBEDDING_DIM=1024
EMBEDDING_MODEL=dev-hashed-v1
EMBEDDING_VERSION=1

# Local embeddings. Install once with `make local-embeddings`.
# Qwen3-Embedding-0.6B uses about 1.2 GB of VRAM and renders 1024 dimensions.
# With a local chat model on a 6 GB card, set LOCAL_EMBEDDING_DEVICE=cpu.
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
LOCAL_EMBEDDING_DEVICE=cuda
LOCAL_EMBEDDING_DTYPE=float16
# GPU batching. CPU uses LOCAL_EMBEDDING_CPU_BATCH_SIZE instead.
LOCAL_EMBEDDING_BATCH_SIZE=16
# On CPU, batch 1 avoids padding every chunk to the longest one in the batch.
# Measured on the reference i5-9400: ~20-25% faster than batch 8 or 16.
LOCAL_EMBEDDING_CPU_BATCH_SIZE=1
# 0 leaves PyTorch's default. Try 4 on a 6-core CPU that also runs the API and
# local chat, leaving headroom for the rest of the stack.
LOCAL_EMBEDDING_THREADS=0
LOCAL_EMBEDDING_MAX_SEQ_LENGTH=512
# In-process cache for repeated query strings. Set to 0 to disable.
LOCAL_EMBEDDING_QUERY_CACHE_SIZE=256
LOCAL_EMBEDDING_QUERY_INSTRUCTION="Given a support question, retrieve passages that answer it"

# Channel thresholds (low, high). Questions below low abstain.
INTERNAL_LOW_THRESHOLD=0.34
INTERNAL_HIGH_THRESHOLD=0.52
PUBLIC_LOW_THRESHOLD=0.55
PUBLIC_HIGH_THRESHOLD=0.72

# Dense retrieval. Below this many eligible chunks the query uses an exact
# cosine scan (100% recall); above it uses the HNSW index. Measured warm on the
# reference machine: ~26 ms at 5k chunks and ~58 ms at 10k. Set to 0 to force
# HNSW everywhere.
DENSE_EXACT_MAX_CHUNKS=5000
# Keep two children per section so a rule and its exception can both be cited.
MAX_CHILDREN_PER_PARENT=2
