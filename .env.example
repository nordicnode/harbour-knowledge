# Local development defaults. Copy to .env before running.
# The database runs in Docker on port 55432 so it never collides with a
# Postgres already installed on the machine.

# Docker Postgres bootstrap. These are read by docker compose; keep the
# MIGRATION_DATABASE_URL below in sync if you change the password or port.
POSTGRES_USER=kb
POSTGRES_PASSWORD=kb_dev_password
POSTGRES_DB=kb
POSTGRES_PORT=55432

# Used by the FastAPI service (RLS-enforced application role)
DATABASE_URL=postgresql://kb_app:kb_app_password@127.0.0.1:55432/kb
# Used only by migrations and the seed script
MIGRATION_DATABASE_URL=postgresql://kb:kb_dev_password@127.0.0.1:55432/kb

APP_ENV=development
API_PORT=8000
WEB_URL=http://127.0.0.1:3000
DEFAULT_TENANT_SLUG=harbour

# Read by the Next.js server. The defaults match the seeded workspace.
API_URL=http://127.0.0.1:8000
DEV_TENANT_SLUG=harbour
DEV_USER_EMAIL=maya@harbour.example

# --- AI providers -----------------------------------------------------------
# Chat and embeddings are selected independently.
#
# AI_MODE=dev    deterministic offline chat, no API key
# AI_MODE=openai any OpenAI-compatible Chat Completions endpoint
#
# EMBEDDING_PROVIDER=dev    deterministic hashed embeddings
# EMBEDDING_PROVIDER=local  Sentence-Transformers on this machine (recommended)
# EMBEDDING_PROVIDER=openai the endpoint's /embeddings route (requires AI_MODE=openai)
AI_MODE=dev
EMBEDDING_PROVIDER=dev

# Fully local chat with Ollama (see README):
# AI_MODE=openai
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# MODEL_INGEST_SMALL=qwen3:4b-instruct-2507-q4_K_M
# MODEL_REWRITE=qwen3:4b-instruct-2507-q4_K_M
# MODEL_ANSWER=qwen3:4b-instruct-2507-q4_K_M
# MODEL_JUDGE=qwen3:4b-instruct-2507-q4_K_M
# EMBEDDING_PROVIDER=local
# On a 6 GB GPU, leave the GPU to chat and embed on the CPU:
# LOCAL_EMBEDDING_DEVICE=cpu
# LOCAL_EMBEDDING_DTYPE=float32

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_EMBEDDING_API_KEY=

# Models are selected by role, never named in application code.
MODEL_INGEST_SMALL=
MODEL_REWRITE=
MODEL_ANSWER=
MODEL_JUDGE=
# Only required when EMBEDDING_PROVIDER=openai.
MODEL_EMBED=
# OpenAI-compatible embedding endpoints accept a `dimensions` parameter. Set
# this to false only for a provider that rejects the parameter; the model must
# still return exactly EMBEDDING_DIM values.
OPENAI_EMBEDDING_DIMENSIONS=true
MODEL_RERANK=

# Optional OpenAI-compatible rerank endpoint (Voyage/Cohere/LiteLLM proxy).
RERANK_BASE_URL=
RERANK_API_KEY=

# The index uses 1024 dimensions (db/migrations/006_local_embeddings.sql).
# Provider, model, dimensions, query instruction, sequence limit, and
# EMBEDDING_VERSION are part of the index identity. Changing any of them
# requires `make reindex`; until then dense retrieval is disabled and Search
# and Ask report keyword-only mode.
EMBEDDING_DIM=1024
EMBEDDING_MODEL=dev-hashed-v1
EMBEDDING_VERSION=1

# Local embeddings. Install once with `make local-embeddings`.
# Qwen3-Embedding-0.6B uses about 1.2 GB of VRAM and renders 1024 dimensions.
# With a local chat model on a 6 GB card, set LOCAL_EMBEDDING_DEVICE=cpu.
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
LOCAL_EMBEDDING_DEVICE=cuda
LOCAL_EMBEDDING_DTYPE=float16
LOCAL_EMBEDDING_BATCH_SIZE=16
LOCAL_EMBEDDING_MAX_SEQ_LENGTH=512
LOCAL_EMBEDDING_QUERY_INSTRUCTION="Given a support question, retrieve passages that answer it"

# Channel thresholds (low, high). Questions below low abstain.
INTERNAL_LOW_THRESHOLD=0.34
INTERNAL_HIGH_THRESHOLD=0.52
PUBLIC_LOW_THRESHOLD=0.55
PUBLIC_HIGH_THRESHOLD=0.72
